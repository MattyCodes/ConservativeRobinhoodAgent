# Copy to .env and fill in. `.env` is gitignored. Never commit real credentials.

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Robinhood Agentic account ---
# The dedicated, separately funded Agentic account number (agentic_allowed=true).
# Leave blank to let the agent discover it via get_accounts on first run.
ROBINHOOD_ACCOUNT_NUMBER=
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Twilio (status + approval SMS) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# --- Switches (see README safety model) ---
# DRYRUN unset  => true  (no orders placed)
# DRYRUN=false  => live orders
DRYRUN=

# APPROVAL_MODE unset => confirm (SMS reply required per order)
# APPROVAL_MODE=notify => fully autonomous
APPROVAL_MODE=

# Dry-run only: starting balance for the simulated paper portfolio (log/paper.jsonl). Bigger
# than the real account so position sizing isn't the bottleneck and the strategy is exercised.
PAPER_START_USD=1000

# Minutes to wait for an SMS approval reply before dropping the proposal (confirm mode).
APPROVAL_TIMEOUT_MINUTES=15

# --- bin/watch.rb (foreground supervisor) ---
# One or more local HH:MM times for the full pass (screen + Claude), comma-separated.
RUN_AT=10:30,15:30
# Lightweight stop-only check (position management, no Claude) every N minutes; 0 disables.
STOP_CHECK_MINUTES=60
# Local window the stop-check runs in.
MARKET_HOURS=09:30-16:00
# Set to false to NOT run one full pass immediately when the watcher starts.
RUN_ON_START=
